<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShnoSetting.Core.ViewModels"
             xmlns:local="using:AvaloniaApplication1"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="220"
             x:Class="AvaloniaApplication1.Views.FeedersView"
             x:DataType="vm:FeedersViewModel">

    <Design.DataContext>
        <local:DesignFeedersViewModel />
    </Design.DataContext>

    <Border Classes="panel">
        <DockPanel>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <TextBlock Classes="h" Text="Фидеры" />
                <TextBlock Grid.Column="1" Foreground="#5F6368" VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Text="Отображаются по назначению входов" />
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleFeeders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FeederViewModel">
                            <Border Classes="feeder" Classes.on="{Binding IsOn}" Margin="2"
                                    Opacity="{Binding SlotOpacity}"
                                    ToolTip.Tip="{Binding Number, StringFormat='Фидер {0}'}">
                                <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
