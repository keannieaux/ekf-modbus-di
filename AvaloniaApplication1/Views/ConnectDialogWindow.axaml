<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShnoSetting.Core.ViewModels"
        xmlns:local="using:AvaloniaApplication1"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AvaloniaApplication1.Views.ConnectDialogWindow"
        x:DataType="vm:MainViewModel"
        Width="430" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Подключение к ПЛК">

    <Design.DataContext>
        <local:DesignMainViewModel />
    </Design.DataContext>

    <StackPanel Margin="16" Spacing="12">

        <TextBlock Name="MessageText" TextWrapping="Wrap" FontWeight="SemiBold" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Профиль:"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}"
                      DisplayMemberBinding="{Binding Name}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="IP:"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Ip}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Порт:"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Port}"
                           Minimum="1" Maximum="65535" FormatString="0"
                           HorizontalAlignment="Stretch" />
        </Grid>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5F6368" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Подключиться" Command="{Binding ConnectCommand}" />
            <Button Content="Отключить" Command="{Binding DisconnectCommand}"
                    IsVisible="{Binding IsConnected}" />
            <Button Content="Закрыть" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
