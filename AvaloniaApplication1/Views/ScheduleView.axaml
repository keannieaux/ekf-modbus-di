<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShnoSetting.Core.ViewModels"
             xmlns:local="using:AvaloniaApplication1"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1140" d:DesignHeight="180"
             x:Class="AvaloniaApplication1.Views.ScheduleView"
             x:DataType="vm:ScheduleViewModel">

    <Design.DataContext>
        <local:DesignScheduleViewModel />
    </Design.DataContext>

    <Border Classes="panel">
        <DockPanel>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <TextBlock Classes="h" Text="График" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                    <Button Content="Прочитать из RTU" Click="OnReadFromRtu"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Загрузить CSV" Click="OnLoadCsv"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="2">
                <TextBlock Name="FileHint" Foreground="#5F6368"
                           Text="«Прочитать из RTU» и «Загрузить CSV» открывают предпросмотр графика" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Область Drag'n'Drop для CSV с графиком -->
            <Border Name="DropZone"
                    BorderBrush="#9AA0A6" BorderThickness="2"
                    CornerRadius="4" Padding="24" MinHeight="80"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="OnDragOver" DragDrop.DragLeave="OnDragLeave"
                    DragDrop.Drop="OnDrop">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="#5F6368"
                           Text="Перетащите сюда CSV-файл с графиком —&#x0a;откроется предпросмотр с записью в ПЛК" />
            </Border>
        </DockPanel>
    </Border>
</UserControl>
