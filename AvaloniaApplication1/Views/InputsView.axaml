<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShnoSetting.Core.ViewModels"
             xmlns:local="using:AvaloniaApplication1"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1140" d:DesignHeight="620"
             x:Class="AvaloniaApplication1.Views.InputsView"
             x:DataType="vm:InputsViewModel">

    <Design.DataContext>
        <local:DesignInputsViewModel />
    </Design.DataContext>

    <Border Classes="panel">
        <DockPanel>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                <TextBlock Classes="h" Text="Дискретные входы" />
                <TextBlock Grid.Column="1" Foreground="#5F6368" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,10,0"
                           Text="Назначение и НО/НЗ записываются в ПЛК сразу при изменении" />
                <Button Grid.Column="2" Content="Сброс входов" VerticalAlignment="Center"
                        Click="OnResetClick" />
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" />

            <ScrollViewer>
                <Grid ColumnDefinitions="Auto,*">

                    <!-- Левая таблица: физические входы и их значения (отдельная таблица) -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <Grid ColumnDefinitions="64,130">
                            <Border Grid.Column="0" Classes="cell head"><TextBlock Text="DI" /></Border>
                            <Border Grid.Column="1" Classes="cell head"><TextBlock Text="Значение входа" /></Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscreteInputViewModel">
                                    <Grid ColumnDefinitions="64,130" Height="38">
                                        <Border Grid.Column="0" Classes="cell">
                                            <TextBlock Text="{Binding Index, StringFormat='DI{0}'}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="1" Classes="cell">
                                            <Ellipse Classes="led" Classes.on="{Binding RawValue}"
                                                     HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Правая таблица: конфигурация позиций -->
                    <StackPanel Grid.Column="1">
                        <Grid ColumnDefinitions="*,150,70,64">
                            <Border Grid.Column="0" Classes="cell head"><TextBlock Text="Наименование" /></Border>
                            <Border Grid.Column="1" Classes="cell head"><TextBlock Text="Назначение входа" /></Border>
                            <Border Grid.Column="2" Classes="cell head"><TextBlock Text="НО/НЗ" /></Border>
                            <Border Grid.Column="3" Classes="cell head"><TextBlock Text="Выход" /></Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscreteInputViewModel">
                                    <Grid ColumnDefinitions="*,150,70,64" Height="38">
                                        <Border Grid.Column="0" Classes="cell" Padding="2">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="1" Classes="cell" Padding="2">
                                            <ComboBox IsEditable="True"
                                                      ItemsSource="{Binding SelectorValues}"
                                                      SelectedItem="{Binding Selector}"
                                                      Text="{Binding SelectorText, UpdateSourceTrigger=LostFocus}"
                                                      BorderThickness="0"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="2" Classes="cell">
                                            <CheckBox IsChecked="{Binding IsNc}" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="3" Classes="cell">
                                            <Ellipse Classes="led" Classes.on="{Binding OutputValue}"
                                                     HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
