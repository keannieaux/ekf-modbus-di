<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShnoSetting.Core.ViewModels"
             xmlns:local="using:AvaloniaApplication1"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1140" d:DesignHeight="620"
             x:Class="AvaloniaApplication1.Views.InputsView"
             x:DataType="vm:InputsViewModel">

    <Design.DataContext>
        <local:DesignInputsViewModel />
    </Design.DataContext>

    <Border Classes="panel">
        <DockPanel>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <TextBlock Classes="h" Text="Дискретные входы" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                    <Button Content="Прочитать конфигурацию" Command="{Binding ReadConfigCommand}" />
                    <Button Content="Записать конфигурацию" Command="{Binding WriteConfigCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" />

            <!-- Заголовок таблицы -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="44,*,64,64,120,70">
                <Border Grid.Column="0" Classes="cell head"><TextBlock Text="№" /></Border>
                <Border Grid.Column="1" Classes="cell head"><TextBlock Text="Наименование" /></Border>
                <Border Grid.Column="2" Classes="cell head"><TextBlock Text="Вход" /></Border>
                <Border Grid.Column="3" Classes="cell head"><TextBlock Text="Выход" /></Border>
                <Border Grid.Column="4" Classes="cell head"><TextBlock Text="Селектор" /></Border>
                <Border Grid.Column="5" Classes="cell head"><TextBlock Text="НО/НЗ" /></Border>
            </Grid>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiscreteInputViewModel">
                            <Grid ColumnDefinitions="44,*,64,64,120,70">
                                <Border Grid.Column="0" Classes="cell">
                                    <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Classes="cell" Padding="2">
                                    <TextBox Text="{Binding Name}" BorderThickness="0" />
                                </Border>
                                <Border Grid.Column="2" Classes="cell">
                                    <Ellipse Classes="led" Classes.on="{Binding RawValue}"
                                             HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="3" Classes="cell">
                                    <Ellipse Classes="led" Classes.on="{Binding OutputValue}"
                                             HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="4" Classes="cell" Padding="2">
                                    <NumericUpDown Value="{Binding Selector}" BorderThickness="0"
                                                   Minimum="0" Maximum="64" FormatString="0" />
                                </Border>
                                <Border Grid.Column="5" Classes="cell">
                                    <CheckBox IsChecked="{Binding IsNc}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
