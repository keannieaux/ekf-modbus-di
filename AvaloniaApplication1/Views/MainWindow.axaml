<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShnoSetting.Core.ViewModels"
        xmlns:local="using:AvaloniaApplication1"
        xmlns:views="using:AvaloniaApplication1.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.ico"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Title="SAVT — настройка ПЛК ШНО">

    <Design.DataContext>
        <local:DesignMainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Шапка: логотип, название, кнопка подключения -->
        <Border Grid.Row="0" BorderBrush="#9AA0A6" BorderThickness="0,0,0,1"
                Padding="14,8" Background="#F7F8FA">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <Image Grid.Column="0" Source="/Assets/savt-logo.png"
                       Height="34" Stretch="Uniform" VerticalAlignment="Center" />

                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Classes="title"
                           Text="Настройка ШНО" HorizontalAlignment="Center" />

                <Button Grid.Column="2" Content="Подключение…" Click="OnOpenConnectDialog"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Переключение вкладок под шапкой (TabBar) -->
        <TabStrip Name="Tabs" Grid.Row="1" Classes="tabbar" SelectedIndex="0"
                  Margin="10,6,10,0" HorizontalAlignment="Center">
            <TabStripItem Content="Управление" />
            <TabStripItem Content="Входы" />
        </TabStrip>

        <!-- Страницы (блокируются, пока нет подключения) -->
        <Carousel Grid.Row="2" Margin="10,4,10,4"
                  IsEnabled="{Binding IsConnected}"
                  SelectedIndex="{Binding #Tabs.SelectedIndex}">

            <Grid RowDefinitions="3*,2*" ColumnDefinitions="2*,3*">
                <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,5,5">
                    <views:StartersView DataContext="{Binding Starters}" Margin="0,0,0,5" />
                    <views:FeedersView Grid.Row="1" DataContext="{Binding Feeders}" />
                </Grid>
                <views:MetersView Grid.Row="0" Grid.Column="1" Margin="5,0,0,5"
                                  DataContext="{Binding Meters}" />
                <views:ScheduleView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                    DataContext="{Binding Schedule}" />
            </Grid>

            <views:InputsView DataContext="{Binding Inputs}" />
        </Carousel>

        <!-- Строка состояния -->
        <Border Grid.Row="3" BorderBrush="#9AA0A6" BorderThickness="0,1,0,0" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Classes="led" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                <TextBlock Classes="label" Text="Период опроса, мс:" Margin="16,0,0,0" />
                <NumericUpDown Value="{Binding PollPeriodMs}" Width="110"
                               Minimum="100" Maximum="60000" Increment="100" FormatString="0" />

                <TextBlock Classes="label" Text="Время ПЛК:" Margin="16,0,0,0" />
                <TextBlock Classes="label" Text="{Binding Clock.PlcTimeText}" FontWeight="SemiBold" />
                <Button Content="Синхронизировать" Command="{Binding Clock.SyncToPcCommand}" />
                <TextBlock Classes="label" Text="{Binding Clock.Status}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
