<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShnoSetting.Core.ViewModels"
        xmlns:local="using:AvaloniaApplication1"
        xmlns:views="using:AvaloniaApplication1.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Title="SAVT — настройка ПЛК ШНО">

    <Design.DataContext>
        <local:DesignMainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Шапка: вкладки, название, параметры подключения -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="10,8,10,4">

            <TabStrip Name="Tabs" Grid.Column="0" SelectedIndex="0" VerticalAlignment="Bottom">
                <TabStripItem Content="Входы" />
                <TabStripItem Content="Управление" />
            </TabStrip>

            <TextBlock Grid.Column="1" Classes="title" Text="SAVT" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="Профиль:" />
                <ComboBox ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberBinding="{Binding Name}"
                          MinWidth="120" />
                <TextBlock Classes="label" Text="IP:" Margin="6,0,0,0" />
                <TextBox Text="{Binding Ip}" Width="140" />
                <TextBlock Classes="label" Text="Port:" />
                <NumericUpDown Value="{Binding Port}" Width="110"
                               Minimum="1" Maximum="65535" FormatString="0" />
                <Button Content="Подключить" Command="{Binding ConnectCommand}" />
                <Button Content="Отключить" Command="{Binding DisconnectCommand}" />
            </StackPanel>
        </Grid>

        <!-- Страницы -->
        <Carousel Grid.Row="1" Margin="10,4,10,4"
                  SelectedIndex="{Binding #Tabs.SelectedIndex}">

            <views:InputsView DataContext="{Binding Inputs}" />

            <Grid RowDefinitions="3*,2*" ColumnDefinitions="2*,3*">
                <views:StartersView Grid.Row="0" Grid.Column="0" Margin="0,0,5,5"
                                    DataContext="{Binding Starters}" />
                <views:MetersView Grid.Row="0" Grid.Column="1" Margin="5,0,0,5"
                                  DataContext="{Binding Meters}" />
                <views:ScheduleView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                    DataContext="{Binding Schedule}" />
            </Grid>
        </Carousel>

        <!-- Строка состояния -->
        <Border Grid.Row="2" BorderBrush="#9AA0A6" BorderThickness="0,1,0,0" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Classes="led" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                <TextBlock Classes="label" Text="Период опроса, мс:" Margin="16,0,0,0" />
                <NumericUpDown Value="{Binding PollPeriodMs}" Width="110"
                               Minimum="100" Maximum="60000" Increment="100" FormatString="0" />

                <TextBlock Classes="label" Text="Время ПЛК:" Margin="16,0,0,0" />
                <TextBlock Classes="label" Text="{Binding Clock.PlcTimeText}" FontWeight="SemiBold" />
                <Button Content="Синхронизировать" Command="{Binding Clock.SyncToPcCommand}" />
                <TextBlock Classes="label" Text="{Binding Clock.Status}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
