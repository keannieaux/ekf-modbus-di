<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="EasyModbusTCP" Version="5.6.0" />
    <!-- EasyModbus собран под .NET Framework и ссылается на System.IO.Ports (ветка Modbus RTU).
         В .NET 10 этой сборки нет в рантайме, без пакета ModbusClient не создаётся даже для TCP. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

</Project>
